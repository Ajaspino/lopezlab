---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { BASE, langOfUrl, ui, LOCALES, switchPath, SITE_LIVE, TRANSLATIONS_INDEXABLE, SITE_URL, withBase, AUTO_LANGUAGE, LANG_PREF_KEY } from '../lib/i18n';
import statsCfg from '../lib/stats-config.json';
interface Props { title: string; description?: string; accent?: string; noindex?: boolean; }
const { title, description, accent, noindex = false } = Astro.props;
const lang = langOfUrl(Astro.url);
const indexable = SITE_LIVE && !noindex && (lang === 'en' || TRANSLATIONS_INDEXABLE);
// Contador de visitas sin cookies: solo en producción, en el dominio real y en páginas indexables (no en /stats/ ni en la 404)
const track = import.meta.env.PROD && !noindex;
const countryOf = Object.fromEntries(Object.entries(statsCfg.timezones));
const countries = [...new Set(Object.values(statsCfg.timezones))];
const abs = (path: string) => new URL(path, SITE_URL).href;
const canonical = abs(Astro.url.pathname);
// Redirección por idioma del navegador: solo en páginas en inglés (no en la 404) y sin elección previa guardada
const autoTargets = AUTO_LANGUAGE && lang === 'en' && !noindex ? Object.fromEntries(LOCALES.filter((l) => l !== 'en').map((l) => [l, switchPath(Astro.url, l)])) : null;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {!indexable && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {indexable && TRANSLATIONS_INDEXABLE && LOCALES.map((l) => <link rel="alternate" hreflang={l} href={abs(switchPath(Astro.url, l))} />)}
    {indexable && TRANSLATIONS_INDEXABLE && <link rel="alternate" hreflang="x-default" href={abs(switchPath(Astro.url, 'en'))} />}
    {autoTargets && <script is:inline define:vars={{ autoTargets, KEY: LANG_PREF_KEY }}>
      (function () {
        try {
          if (localStorage.getItem(KEY)) return;
          var prefs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
          for (var i = 0; i < prefs.length; i++) {
            var l = String(prefs[i]).toLowerCase().split('-')[0];
            if (l === 'en') return;
            if (autoTargets[l]) { location.replace(autoTargets[l]); return; }
          }
        } catch (e) {}
      })();
    </script>}
    {track && <script is:inline define:vars={{ NS: statsCfg.namespace, API: statsCfg.api, HOST: new URL(SITE_URL).hostname, MAP: countryOf, COUNTRIES: countries, LANGS: statsCfg.languages, BASE, LOCS: LOCALES.filter((l) => l !== 'en') }}>
      // Cuenta una visita por sesión del navegador: total, día, país (estimado por la zona horaria) e idioma. Sin cookies ni identificadores.
      (function () {
        try {
          if (location.hostname !== HOST) return;
          if (navigator.doNotTrack === '1' || navigator.webdriver) return;
          if (/bot|crawl|spider|headless|lighthouse/i.test(navigator.userAgent)) return;
          if (localStorage.getItem('lopezlab:no-track')) return;
          // Página vista (sin idioma ni ruta base): p-home, p-work, p-project_<slug>, p-post_<slug>, p-work_<categoría>...
          var path = location.pathname;
          if (BASE && path.indexOf(BASE) === 0) path = path.slice(BASE.length);
          path = path.replace(new RegExp('^/(' + LOCS.join('|') + ')(?=/|$)'), '').replace(/^\/|\/$/g, '');
          var pk = 'p-' + (path ? path.toLowerCase().replace(/\//g, '_').replace(/[^a-z0-9_-]/g, '-') : 'home');
          fetch(API + '/hit/' + NS + '/' + pk, { keepalive: true }).catch(function () {});
          // El resto (visita, día, país, idioma, dispositivo y navegador) una vez por sesión
          if (sessionStorage.getItem('lopezlab:counted')) return;
          sessionStorage.setItem('lopezlab:counted', '1');
          var tz = '';
          try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}
          var cc = MAP[tz];
          if (!cc) { var m = /-([A-Za-z]{2})$/.exec(navigator.language || ''); cc = m ? m[1].toUpperCase() : 'XX'; }
          if (COUNTRIES.indexOf(cc) < 0) cc = 'XX';
          var lg = (navigator.language || '').slice(0, 2).toLowerCase();
          if (LANGS.indexOf(lg) < 0) lg = 'other';
          var ua = navigator.userAgent;
          // Dispositivo: móvil, tableta (incluye iPad, que se presenta como Mac con pantalla táctil) o escritorio
          var dv = /iPad|Tablet/i.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1) || (/Android/.test(ua) && !/Mobile/.test(ua)) ? 'tablet' : /Mobi|iPhone|iPod|Android/i.test(ua) ? 'mobile' : 'desktop';
          // Navegador, por orden de especificidad (Edge, Opera y Samsung también dicen "Chrome")
          var br = /Edg(e|A|iOS)?\//.test(ua) ? 'edge' : /OPR\/|Opera/.test(ua) ? 'opera' : /SamsungBrowser/.test(ua) ? 'samsung' : /Firefox|FxiOS/.test(ua) ? 'firefox' : /Chrome|CriOS/.test(ua) ? 'chrome' : /Safari/.test(ua) ? 'safari' : 'other';
          var day = new Date().toISOString().slice(0, 10);
          ['visits', 'd-' + day, 'c-' + cc, 'l-' + lg, 'dv-' + dv, 'b-' + br].forEach(function (k) {
            fetch(API + '/hit/' + NS + '/' + k, { keepalive: true }).catch(function () {});
          });
        } catch (e) {}
      })();
    </script>}
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="theme-color" content="#fcfcfc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f0f0f" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <meta property="og:site_name" content="Lopezlab" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(withBase('/og-image.png'))} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {description && <meta property="og:description" content={description} />}
  </head>
  <body style={accent ? `--accent:${accent}` : undefined}>
    <a class="skip" href="#main">{ui(lang, 'ui.skip')}</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
