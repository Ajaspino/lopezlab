---
import Base from '../../layouts/Base.astro';
import data from '../../data/stats.json';
import pagesData from '../../data/pages.json';
import { projectsFor, categoriesFor } from '../../lib/images';
import { langFrom, langStaticPaths, hrefFor, localize, ui } from '../../lib/i18n';
export const getStaticPaths = () => langStaticPaths();
const lang = langFrom(Astro.params.lang);
// Textos de la página. ES, GL y NL son borrador para que los revise Mariola.
const T = {
  en: { pagesTitle: 'Most visited pages', home: 'Home', title: 'Stats', none: 'No data yet. Numbers will appear here after the first visits, and are refreshed every few hours.', last30: 'Visits · last 30 days', all: 'Visits · all time', best: 'Best day', top: 'Top country', perDay: 'Visits per day', chart: 'Visits per day, {from} to {to}. Best day: {n}.', countries: 'Countries', langs: 'Browser languages', devices: 'Devices', browsers: 'Browsers', mobile: 'Mobile', tablet: 'Tablet', desktop: 'Desktop', other: 'Other', unknown: 'Unknown', samsung: 'Samsung Internet', updated: 'Updated', note: 'Data is collected without cookies, without login and without storing personal data on this site. For each browser session we record: a visit, the day, the country (estimated from the browser’s time zone), the browser language, the device type and the browser. Each page opened also adds one view to that page. The counts are stored in a public counting service (abacus.jasoncameron.dev), which receives the visitor’s IP address like any web request; this site does not store it. We count visits, not people, and the country can be off for travellers or VPNs.', btn: 'Don’t count my visits on this device', locale: 'en-GB' },
  es: { pagesTitle: 'Páginas más vistas', home: 'Inicio', title: 'Estadísticas', none: 'Aún no hay datos. Los números aparecerán aquí tras las primeras visitas y se actualizan cada pocas horas.', last30: 'Visitas · últimos 30 días', all: 'Visitas · total', best: 'Mejor día', top: 'País principal', perDay: 'Visitas por día', chart: 'Visitas por día, del {from} al {to}. Mejor día: {n}.', countries: 'Países', langs: 'Idiomas del navegador', devices: 'Dispositivos', browsers: 'Navegadores', mobile: 'Móvil', tablet: 'Tableta', desktop: 'Escritorio', other: 'Otros', unknown: 'Desconocido', samsung: 'Samsung Internet', updated: 'Actualizado', note: 'Los datos se recogen sin cookies, sin login y sin guardar datos personales en esta web. Por cada sesión del navegador se registran: una visita, el día, el país (estimado por la zona horaria del navegador), el idioma del navegador, el tipo de dispositivo y el navegador. Además, cada página abierta suma una vista a esa página. Los recuentos se guardan en un servicio público de contadores (abacus.jasoncameron.dev), que recibe la dirección IP del visitante como cualquier petición web; esta web no la guarda. Se cuentan visitas, no personas, y el país puede fallar con viajeros o VPN.', btn: 'No contar mis visitas en este dispositivo', locale: 'es-ES' },
  gl: { pagesTitle: 'Páxinas máis vistas', home: 'Inicio', title: 'Estatísticas', none: 'Aínda non hai datos. Os números aparecerán aquí tras as primeiras visitas e actualízanse cada poucas horas.', last30: 'Visitas · últimos 30 días', all: 'Visitas · total', best: 'Mellor día', top: 'País principal', perDay: 'Visitas por día', chart: 'Visitas por día, do {from} ao {to}. Mellor día: {n}.', countries: 'Países', langs: 'Idiomas do navegador', devices: 'Dispositivos', browsers: 'Navegadores', mobile: 'Móbil', tablet: 'Tableta', desktop: 'Escritorio', other: 'Outros', unknown: 'Descoñecido', samsung: 'Samsung Internet', updated: 'Actualizado', note: 'Os datos recóllense sen cookies, sen login e sen gardar datos persoais nesta web. Por cada sesión do navegador rexístranse: unha visita, o día, o país (estimado pola zona horaria do navegador), o idioma do navegador, o tipo de dispositivo e o navegador. Ademais, cada páxina aberta suma unha vista a esa páxina. Os recontos gárdanse nun servizo público de contadores (abacus.jasoncameron.dev), que recibe a dirección IP do visitante coma en calquera petición web; esta web non a garda. Cóntanse visitas, non persoas, e o país pode fallar con viaxeiros ou VPN.', btn: 'Non contar as miñas visitas neste dispositivo', locale: 'gl-ES' },
  nl: { pagesTitle: 'Meest bezochte pagina’s', home: 'Home', title: 'Statistieken', none: 'Nog geen gegevens. De cijfers verschijnen hier na de eerste bezoeken en worden om de paar uur bijgewerkt.', last30: 'Bezoeken · laatste 30 dagen', all: 'Bezoeken · totaal', best: 'Beste dag', top: 'Belangrijkste land', perDay: 'Bezoeken per dag', chart: 'Bezoeken per dag, van {from} tot {to}. Beste dag: {n}.', countries: 'Landen', langs: 'Browsertalen', devices: 'Apparaten', browsers: 'Browsers', mobile: 'Mobiel', tablet: 'Tablet', desktop: 'Desktop', other: 'Overig', unknown: 'Onbekend', samsung: 'Samsung Internet', updated: 'Bijgewerkt', note: 'De gegevens worden verzameld zonder cookies, zonder login en zonder persoonsgegevens op deze website op te slaan. Per browsersessie wordt vastgelegd: een bezoek, de dag, het land (geschat op basis van de tijdzone van de browser), de browsertaal, het type apparaat en de browser. Daarnaast telt elke geopende pagina als één weergave van die pagina. De tellingen worden opgeslagen in een openbare tellerdienst (abacus.jasoncameron.dev), die het IP-adres van de bezoeker ontvangt zoals bij elk webverzoek; deze website slaat het niet op. We tellen bezoeken, geen personen, en het land kan afwijken bij reizigers of VPN.', btn: 'Tel mijn bezoeken op dit apparaat niet mee', locale: 'nl-NL' },
}[lang];
const s = data as any;
// Nombre de cada página en el idioma actual y enlace a ella
const projectList = projectsFor(lang);
const categoryList = categoriesFor(lang);
const postList = (localize(pagesData, lang, 'pages') as any).posts;
const pageName = (path: string) => {
  if (path === '/') return T.home;
  if (path === '/work/') return ui(lang, 'ui.nav.work');
  if (path === '/about/') return ui(lang, 'ui.nav.about');
  if (path === '/contact/') return ui(lang, 'ui.nav.contact');
  const [, kind, slug] = path.split('/');
  if (kind === 'project') return projectList.find((p) => p.slug === slug)?.title ?? slug;
  if (kind === 'post') return postList[slug]?.title ?? slug;
  if (kind === 'work') return categoryList.find((c) => c.slug === slug)?.name ?? slug;
  return path;
};
const topPages: { path: string; value: number }[] = (s.pages ?? []).slice(0, 10);
const topMax = Math.max(1, ...topPages.map((p) => p.value));
const has = !!s.generatedAt;
const dn = (type: 'region' | 'language') => { try { return new Intl.DisplayNames(T.locale, { type }); } catch { return new Intl.DisplayNames('en', { type }); } };
const regions = dn('region');
const languages = dn('language');
const countryName = (c: string) => (c === 'XX' ? T.unknown : regions.of(c) ?? c);
const langName = (l: string) => (l === 'other' ? T.other : languages.of(l) ?? l);
const deviceName = (d: string) => (T as any)[d] ?? d;
const browserName = (b: string) => ({ chrome: 'Chrome', safari: 'Safari', firefox: 'Firefox', edge: 'Edge', samsung: T.samsung, opera: 'Opera', other: T.other } as Record<string, string>)[b] ?? b;
const fmt = (n: number) => n.toLocaleString(T.locale);
const day = (d: string) => new Date(d + 'T12:00:00Z').toLocaleDateString(T.locale, { day: 'numeric', month: 'short', timeZone: 'UTC' });
const updated = has ? new Date(s.generatedAt).toLocaleString(T.locale, { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Europe/Amsterdam' }) : '';
const days: { date: string; visits: number }[] = s.days ?? [];
const max = Math.max(1, ...days.map((d) => d.visits));
const best = days.reduce((b, d) => (d.visits > (b?.visits ?? -1) ? d : b), null as null | { date: string; visits: number });
const topCountry = s.countries?.find((c: any) => c.code !== 'XX');
const shareOf = (list: any[], v: number) => { const t = list.reduce((a, x) => a + x.value, 0) || 1; return Math.round((v / t) * 100); };
---
<Base title={`${T.title} | LopezLab`} noindex>
  <div class="wrap stats">
    <h1 class="h-1">{T.title}</h1>
    {!has && <p class="lead">{T.none}</p>}
    {has && (
      <Fragment>
        <dl class="kpis">
          <div><dt>{T.last30}</dt><dd>{fmt(s.last30)}</dd></div>
          <div><dt>{T.all}</dt><dd>{fmt(s.total)}</dd></div>
          <div><dt>{T.best}</dt><dd>{best && best.visits > 0 ? fmt(best.visits) : '–'}<small>{best && best.visits > 0 ? day(best.date) : ''}</small></dd></div>
          <div><dt>{T.top}</dt><dd class="txt">{topCountry ? countryName(topCountry.code) : '–'}</dd></div>
        </dl>

        <section aria-labelledby="h-days">
          <h2 id="h-days" class="label">{T.perDay}</h2>
          <div class="bars" role="img" aria-label={T.chart.replace('{from}', day(days[0].date)).replace('{to}', day(days[days.length - 1].date)).replace('{n}', String(best?.visits ?? 0))}>
            {days.map((d) => <span style={`--h:${Math.max(d.visits ? 3 : 0, Math.round((d.visits / max) * 100))}%`} title={`${day(d.date)}: ${d.visits}`}></span>)}
          </div>
          <p class="axis"><span>{day(days[0].date)}</span><span>{day(days[days.length - 1].date)}</span></p>
        </section>


        {topPages.length > 0 && (
          <section aria-labelledby="h-pages">
            <h2 id="h-pages" class="label">{T.pagesTitle}</h2>
            <ol class="rank pages">
              {topPages.map((pg) => <li style={`--w:${Math.round((pg.value / topMax) * 100)}%`}><a href={hrefFor(lang, pg.path)}>{pageName(pg.path)}</a><b>{fmt(pg.value)}</b></li>)}
            </ol>
          </section>
        )}

        <div class="ranks">
          <section aria-labelledby="h-countries">
            <h2 id="h-countries" class="label">{T.countries}</h2>
            <ol class="rank">
              {s.countries.slice(0, 10).map((c: any) => <li style={`--w:${shareOf(s.countries, c.value)}%`}><span>{countryName(c.code)}</span><b>{shareOf(s.countries, c.value)}%</b></li>)}
            </ol>
          </section>
          <section aria-labelledby="h-langs">
            <h2 id="h-langs" class="label">{T.langs}</h2>
            <ol class="rank">
              {s.languages.slice(0, 10).map((l: any) => <li style={`--w:${shareOf(s.languages, l.value)}%`}><span>{langName(l.code)}</span><b>{shareOf(s.languages, l.value)}%</b></li>)}
            </ol>
          </section>
          <section aria-labelledby="h-devices">
            <h2 id="h-devices" class="label">{T.devices}</h2>
            <ol class="rank">
              {(s.devices ?? []).map((d: any) => <li style={`--w:${shareOf(s.devices, d.value)}%`}><span>{deviceName(d.code)}</span><b>{shareOf(s.devices, d.value)}%</b></li>)}
            </ol>
          </section>
          <section aria-labelledby="h-browsers">
            <h2 id="h-browsers" class="label">{T.browsers}</h2>
            <ol class="rank">
              {(s.browsers ?? []).map((b: any) => <li style={`--w:${shareOf(s.browsers, b.value)}%`}><span>{browserName(b.code)}</span><b>{shareOf(s.browsers, b.value)}%</b></li>)}
            </ol>
          </section>
        </div>
        <p class="note">{T.updated} {updated}</p>
      </Fragment>
    )}
    <p class="note">{T.note}</p>
    <label class="switch"><input type="checkbox" role="switch" id="notrack" /><span class="track" aria-hidden="true"></span><span>{T.btn}</span></label>
  </div>
</Base>
<script is:inline>
  // Interruptor: activado = este dispositivo no se cuenta (se guarda en el navegador y se puede cambiar cuando quieras)
  (function () {
    var sw = document.getElementById('notrack'), KEY = 'lopezlab:no-track';
    try { sw.checked = !!localStorage.getItem(KEY); } catch (e) {}
    sw.addEventListener('change', function () {
      try { if (sw.checked) localStorage.setItem(KEY, '1'); else localStorage.removeItem(KEY); } catch (e) {}
    });
  })();
</script>
