---
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import pages from '../../data/pages.json';
import { accentOf, projectsFor, coverFor } from '../../lib/images';
import { langFrom, hrefFor, langStaticPaths, localize, ui } from '../../lib/i18n';
const lang = langFrom(Astro.params.lang);
const t = (p: string) => hrefFor(lang, p);
const h = localize(pages, lang, 'pages').home;
const projects = projectsFor(lang);
const feature = projects.find((p) => p.slug === h.feature.slug)!;
// Título de la pestaña y de los buscadores (ES, GL y NL son borrador para que los revise Mariola)
const tagline: Record<string, string> = { en: 'Strategic communication & design studio', es: 'Estudio de comunicación estratégica y diseño', gl: 'Estudo de comunicación estratéxica e deseño', nl: 'Studio voor strategische communicatie en design' };
export const getStaticPaths = () => langStaticPaths();
---
<Base title={`Lopezlab Amsterdam | ${tagline[lang]}`} description={h.method.text}>
  <section class="hero wrap">
    <h1 class="h-display">{h.hero.title}</h1>
    <p class="sub">{h.hero.sub}</p>
    <a class="shot" href={t('/post/our-method/')} aria-label={h.method.cta}>
      <div class="ph"><Img file="hero-home.jpg" alt="" sizes="100vw" loading="eager" fetchpriority="high" widths={[480, 800, 1200, 1800, 2200]} position="50% 40%" /></div>
    </a>
  </section>

  <section class="method wrap">
    <p>{h.method.text}</p>
    <a class="link-arrow" href={t('/post/our-method/')}>{h.method.cta}</a>
  </section>

  <section class="spotlight" style={`--accent:${accentOf(feature.slug)}`}>
    <div class="wrap">
      <a href={t(`/project/${feature.slug}/`)}>
        <div>
          <h2 class="words">{h.feature.words.map((w) => <span>{w}</span>)}</h2>
          <p class="sub">{h.feature.sub}</p>
        </div>
        <div class="ph"><Img file={coverFor(feature.slug, feature.cover)} alt="" sizes="(min-width: 900px) 40vw, 100vw" position="35% 50%" /></div>
      </a>
    </div>
  </section>

  <section class="section wrap" aria-label={ui(lang, 'ui.work.selected')}>
    <ul class="feed">
      {[...h.featured, ...h.more].map((c) => <li><ProjectCard slug={c.slug} title={c.title} label={c.label} cover={coverFor(c.slug, c.cover)} alt={c.alt} /></li>)}
    </ul>
  </section>

  <section class="post-teaser">
    <div class="wrap">
      <a href={t('/post/clarity-is-a-strategy/')}>
        <h2>{h.postTeaser.title}</h2>
        <div>
          <p>{h.postTeaser.sub}</p>
          <span class="link-arrow">{h.postTeaser.cta}</span>
        </div>
      </a>
    </div>
  </section>

  <section class="cta wrap">
    <h2>{ui(lang, 'ui.contact.intro')}</h2>
    <a class="link-arrow" href={t('/contact/')}>{ui(lang, 'ui.nav.contact')}</a>
  </section>
</Base>
