---
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import pages from '../../data/pages.json';
import { langFrom, hrefFor, langStaticPaths, localize, ui } from '../../lib/i18n';
const lang = langFrom(Astro.params.lang);
const t = (p: string) => hrefFor(lang, p);
const a = localize(pages, lang, 'pages').about;
import { sentenceCase } from '../../lib/text';
// Clientes en una sola lista alfabética (sin subsecciones). "Name of client" es un marcador de plantilla que quedó publicado y se omite.
// Se unifican repetidos (Esero, Flamenco Biënnale, A.S.R. / asr) y las mayúsculas de los nombres escritos todo en minúscula.
const norm = (n: string) => n.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]/g, '');
const pretty = (n: string) => n.trim().replace(/(^|[\s+])(\p{Ll})/gu, (_, s, c) => s + c.toUpperCase());
const byKey = new Map<string, string>();
for (const g of a.method.clients) for (const n of g.names) {
  if (n === 'Name of client') continue;
  const k = norm(n), cur = byKey.get(k);
  if (!cur || (cur === cur.toLowerCase() && n !== n.toLowerCase())) byKey.set(k, n);   // si hay dos grafías, gana la que lleva mayúsculas
}
const clientNames = [...byKey.values()].map(pretty).sort((x, y) => x.localeCompare(y, lang, { sensitivity: 'base', ignorePunctuation: true }));
// Logos en SVG de un solo color (currentColor: negro, y blanco en modo oscuro). Los clientes sin logo se muestran con su nombre.
const logoFiles = import.meta.glob('../../assets/clients/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const logoByKey: Record<string, string> = { asr: 'asr', arriva: 'arriva', esero: 'esero', ferring: 'ferring', flamencobiennale: 'flamenco', xolvio: 'xolvio', marcelwanders: 'wanders' };
const logoFor = (n: string) => { const f = logoByKey[norm(n)]; return f ? logoFiles[`../../assets/clients/${f}.svg`] : undefined; };
export const getStaticPaths = () => langStaticPaths();
---
<Base title={`${ui(lang, 'ui.about.title')} | LopezLab`} description={a.whatWeDo.text}>
  <div class="wrap about">
    <section class="block">
      <h1 class="h-1">{a.whatWeDo.title}</h1>
      <p class="text">{a.whatWeDo.text}</p>
    </section>

    <section class="block">
      <h2 class="h-1">{a.whoWeAre.title}</h2>
      <div>
        <p class="text">{a.whoWeAre.text}</p>
        <ul class="team">
          {a.team.map((m) => (
            <li>
              <div class="ph"><Img file={m.photo} alt={m.alt} sizes="(min-width: 640px) 30vw, 100vw" widths={[400, 640, 900]} /></div>
              <h3>{m.name}</h3>
              <p>{m.role}</p>
              <p><a href={`mailto:${m.email}`}>{m.email}</a></p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="block" id="method">
      <h2 class="h-1">{sentenceCase(a.method.title)}</h2>
      <div>
        <p class="text">{a.method.text}</p>
      </div>
    </section>

    <section class="block" id="clients">
      <h2 class="h-1">{sentenceCase(ui(lang, 'ui.home.who'))}</h2>
      <div>
        <ul class="client-wall">
          {clientNames.map((n) => {
            const svg = logoFor(n);
            return <li>{svg ? <span class="logo" role="img" aria-label={n} set:html={svg} /> : <span class="name">{n}</span>}</li>;
          })}
        </ul>
        <p class="text" style="margin-top:4rem"><a href={t('/contact/')}>{a.method.outro}</a></p>
      </div>
    </section>
  </div>
</Base>
