---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/i18n';
---
<Base title="Page not found | LopezLab" noindex>
  <div class="wrap notfound">
    <p class="label">404</p>
    <h1 class="h-1">Page not found</h1>
    <p class="lead">The page you are looking for has moved or does not exist.</p>
    <p class="links"><a class="link-arrow" href={withBase('/')}>Home</a> <a class="link-arrow" href={withBase('/work/')}>Work</a></p>
  </div>
</Base>
