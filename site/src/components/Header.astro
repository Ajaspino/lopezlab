---
import LangToggle from './LangToggle.astro';
import { langOfUrl, hrefFor, ui, stripBase } from '../lib/i18n';
const lang = langOfUrl(Astro.url);
const path = stripBase(Astro.url.pathname).replace(new RegExp(`^/${lang}(?=/)`), '') || '/';
const items = [[ui(lang, 'ui.nav.work'), '/work/'], [ui(lang, 'ui.nav.about'), '/about/'], [ui(lang, 'ui.nav.contact'), '/contact/']];
const current = (href: string) => path.startsWith(href) || (href === '/work/' && path.startsWith('/project/'));
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href={hrefFor(lang, '/')} aria-label="Lopezlab Amsterdam."><span class="brand-full">Lopezlab Amsterdam.</span><span class="brand-short" aria-hidden="true">Lopezlab Ams.</span></a>
    <div class="head-right">
      <nav class="nav" aria-label={ui(lang, 'ui.nav.main')}>
        {items.map(([name, href]) => <a href={hrefFor(lang, href)} aria-current={current(href) ? 'page' : undefined}>{name}</a>)}
      </nav>
      <LangToggle />
    </div>
    <button class="menu-toggle" id="menu-toggle" type="button" aria-controls="mobile-menu" aria-expanded="false"
      aria-label={ui(lang, 'ui.menu.open')} data-open={ui(lang, 'ui.menu.open')} data-close={ui(lang, 'ui.menu.close')}>
      <span></span><span></span><span></span>
    </button>
  </div>
</header>
<div class="mobile-menu" id="mobile-menu" inert>
  <nav aria-label={ui(lang, 'ui.nav.main')}>
    <ul class="mobile-nav">
      {items.map(([name, href]) => <li><a href={hrefFor(lang, href)} aria-current={current(href) ? 'page' : undefined}>{name}</a></li>)}
    </ul>
  </nav>
  <LangToggle class="menu-lang" />
</div>
<script>
  const toggle = document.getElementById('menu-toggle') as HTMLButtonElement | null;
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    const set = (open: boolean) => {
      toggle.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', (open ? toggle.dataset.close : toggle.dataset.open) ?? '');
      menu.classList.toggle('is-open', open);
      if (open) menu.removeAttribute('inert'); else menu.setAttribute('inert', '');
      document.documentElement.classList.toggle('menu-open', open);
      if (open) menu.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
    };
    toggle.addEventListener('click', () => set(!menu.classList.contains('is-open')));
    menu.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) set(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menu.classList.contains('is-open')) { set(false); toggle.focus(); } });
    matchMedia('(min-width: 768px)').addEventListener('change', (e) => { if (e.matches) set(false); });
  }
</script>
